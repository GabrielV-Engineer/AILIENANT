# --- VIRTUAL ENVIRONMENTS (Inode protection & performance) ---
venv/
.venv/
env/
__pycache__/
**/__pycache__/
.env
**/.env
.env.local
*.pem

# --- SECRETS & SECURITY (Leak prevention) ---
.env
.env.*
secrets.json
keys/

# --- IDE & OS ---
.vscode/
.DS_Store

# --- LOCAL DATA (Lock prevention) ---
*.db
*.sqlite3
.vector_store/

# ==========================================
# INFRASTRUCTURE SHIELD (Node & React)
# ==========================================
node_modules/
**/node_modules/
dist/
**/dist/
out/
**/out/
build/
**/build/
.npm/

# ==========================================
# BACKEND SHIELD (Python)
# ==========================================
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
**/venv/

# --- Coverage artifacts (pytest-cov) ---
.coverage
.coverage.*
coverage.xml
test-results.xml
htmlcov/

# ==========================================
# IDE & OS SHIELD
# ==========================================
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.history/
*.log
*.tmp
.DS_Store
Thumbs.db

# ==========================================
# AILIENANT SHIELD (Runtime / Local / Secrets)
# ==========================================
# Local databases (SQLite + WAL/SHM) — runtime, never versioned
*.sqlite
*.sqlite-shm
*.sqlite-wal
# Local config and provider secrets (BYOM / API keys)
byom_config.json
mcp_secrets.json
config.yaml
# OpenSpec's project-context config is not a secret — must stay tracked so
# CI checkouts and other clones have the schema/context declaration.
!openspec/config.yaml
# Local agent tooling (Claude Code)
.claude/
# graphify local knowledge graph (regenerated via `graphify update .`, dev-tool only)
graphify-out/
# Live telemetry sink (audit surface with snippets/prompts) — runtime, never versioned
.ailienant_telemetry.log
**/.ailienant_telemetry.log
# Auto-generated checkpoint report (regenerated on every gate run)
CHECKPOINT_REPORT.md
# vscode-test download cache (npm test downloads VS Code ~225 MB on demand)
ailienant-extension/.vscode-test/

# Temporary/scratch files
mypy_out.txt
compile_out.txt
ailienant_lancedb/
gateway_ledger.json
.vscode-test/
.benchmark_eval/

# Playwright (dashboard checkpoint gate) — fixture ids + run artifacts
ailienant-extension/e2e/.fixture-data/
ailienant-extension/test-results/
ailienant-extension/playwright-report/
